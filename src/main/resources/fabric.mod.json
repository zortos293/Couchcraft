{
	"schemaVersion": 1,
	"id": "couchcraft",
	"version": "${version}",
	"name": "Couchcraft",
	"description": "True single-client split screen. Up to four players on one Minecraft window, one process, one world — controllers first, like the old days.",
	"authors": [
		"Zortos"
	],
	"license": "MIT",
	"icon": "assets/couchcraft/icon.png",
	"contact": {
		"sources": "https://github.com/zortos293/Couchcraft",
		"issues": "https://github.com/zortos293/Couchcraft/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.couchcraft.Couchcraft"
		]
	},
	"mixins": [
		"couchcraft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"breaks": {
		"sodium": "*",
		"iris": "*"
	}
}
